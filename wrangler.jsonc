{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "costco-carburantes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-25",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/robots.txt", "/sitemap.xml"] },
  "d1_databases": [{ "binding": "DB", "database_name": "costco-carburantes", "database_id": "DB_ID_REQUIRED" }],
  "triggers": { "crons": ["*/10 * * * *", "28 5 * * *"] },
  "vars": { "TELEGRAM_ENABLED": "false", "OFFICIAL_ENABLED": "false" }
}
